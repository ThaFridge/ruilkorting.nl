---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import DestinationCard from '../../components/DestinationCard.astro';
import { withBase } from '../../lib/url.ts';

export async function getStaticPaths() {
  const seasons = await getCollection('seasons');
  return seasons.map((s) => ({ params: { slug: s.id }, props: { season: s } }));
}
const { season } = Astro.props;
const [destinations, cities, stations, categories] = await Promise.all([
  getCollection('destinations', (d) => d.data.published && d.data.seasons.some((s) => s.id === season.id)),
  getCollection('cities'),
  getCollection('stations'),
  getCollection('categories'),
]);
const cityName = new Map(cities.map((c) => [c.id, c.data.title]));
const stationName = new Map(stations.map((s) => [s.id, s.data.name]));
const categoryName = new Map(categories.map((c) => [c.id, c.data.name]));
const monthNames = ['jan', 'feb', 'mrt', 'apr', 'mei', 'jun', 'jul', 'aug', 'sep', 'okt', 'nov', 'dec'];
---

<Base title={season.data.name} description={season.data.description} path={`/seizoenen/${season.id}/`}>
  <nav aria-label="Kruimelpad" class="text-sm text-slate-500"><a href={withBase('/')} class="hover:underline">Home</a> › <a href={withBase('/seizoenen/')} class="hover:underline">Seizoenen</a> › <span aria-current="page">{season.data.name}</span></nav>
  <h1 class="mt-4 text-3xl font-bold">{season.data.name}</h1>
  <p class="mt-2 text-lg text-slate-700">{season.data.description}</p>
  <p class="mt-1 text-sm text-slate-500">Relevant in: {season.data.months.map((m) => monthNames[m - 1]).join(', ')}</p>
  {destinations.length === 0 ? (
    <p class="mt-6 rounded-lg bg-slate-50 p-4 text-slate-600">Nog geen bestemmingen voor dit seizoen.</p>
  ) : (
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {destinations.map((d) => (
        <DestinationCard destination={d} cityName={cityName.get(d.data.city.id) ?? ''} stationName={stationName.get(d.data.nearest_station.id) ?? ''} categoryNames={d.data.categories.map((c) => categoryName.get(c.id) ?? c.id)} />
      ))}
    </div>
  )}
</Base>
