---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import DestinationCard from '../../components/DestinationCard.astro';
import { withBase } from '../../lib/url.ts';

export async function getStaticPaths() {
  const cities = await getCollection('cities');
  return cities.map((c) => ({ params: { slug: c.id }, props: { city: c } }));
}
const { city } = Astro.props;
const { Content } = await render(city);
const station = await getEntry(city.data.station);
const [destinations, stations, categories] = await Promise.all([
  getCollection('destinations', (d) => d.data.published && d.data.city.id === city.id),
  getCollection('stations'),
  getCollection('categories'),
]);
const stationName = new Map(stations.map((s) => [s.id, s.data.name]));
const categoryName = new Map(categories.map((c) => [c.id, c.data.name]));
---

<Base title={city.data.title} description={city.data.summary} path={`/steden/${city.id}/`}>
  <nav aria-label="Kruimelpad" class="text-sm text-slate-500"><a href={withBase('/')} class="hover:underline">Home</a> › <span aria-current="page">{city.data.title}</span></nav>
  <h1 class="mt-4 text-3xl font-bold">{city.data.title}</h1>
  <p class="mt-1 text-sm text-slate-600">{city.data.province} · dichtstbijzijnde station: {station!.data.name}</p>
  <p class="mt-3 text-lg text-slate-700">{city.data.summary}</p>
  <div class="mt-4 text-slate-800 [&_p]:mt-3"><Content /></div>
  <section class="mt-8">
    <h2 class="text-2xl font-bold">Uitjes in {city.data.title}</h2>
    {destinations.length === 0 ? (
      <p class="mt-2 text-slate-600">Nog geen bestemmingen beschreven.</p>
    ) : (
      <div class="mt-3 grid gap-4 sm:grid-cols-2">
        {destinations.map((d) => (
          <DestinationCard destination={d} cityName={city.data.title} stationName={stationName.get(d.data.nearest_station.id) ?? ''} categoryNames={d.data.categories.map((c) => categoryName.get(c.id) ?? c.id)} />
        ))}
      </div>
    )}
  </section>
</Base>
