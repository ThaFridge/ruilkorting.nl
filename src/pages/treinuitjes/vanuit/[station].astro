---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import DestinationCard from '../../../components/DestinationCard.astro';
import FreshnessBadge from '../../../components/FreshnessBadge.astro';
import { listReachabilityStations, readReachability } from '../../../lib/data/reachability.ts';
import { PLANNER_URL, withBase } from '../../../lib/url.ts';

export async function getStaticPaths() {
  const stations = await getCollection('stations');
  const available = new Set(await listReachabilityStations());
  return stations.filter((s) => available.has(s.id)).map((s) => ({ params: { station: s.id }, props: { station: s } }));
}
const { station } = Astro.props;
const reach = await readReachability(station.id);
const [destinations, cities, stations, categories] = await Promise.all([
  getCollection('destinations', (d) => d.data.published),
  getCollection('cities'),
  getCollection('stations'),
  getCollection('categories'),
]);
const byId = new Map(destinations.map((d) => [d.id, d]));
const cityName = new Map(cities.map((c) => [c.id, c.data.title]));
const stationName = new Map(stations.map((s) => [s.id, s.data.name]));
const categoryName = new Map(categories.map((c) => [c.id, c.data.name]));
const estimated = reach.source.startsWith('estimate');
const rows = reach.items.map((item) => ({ item, d: byId.get(item.destination) })).filter((r) => r.d);
---

<Base title={`Treinuitjes vanuit ${station.data.name}`} description={`Alle uitjes die je vanuit ${station.data.name} met trein en bus kunt bereiken, gesorteerd op reistijd.`} path={`/treinuitjes/vanuit/${station.id}/`}>
  <nav aria-label="Kruimelpad" class="text-sm text-slate-500"><a href={withBase('/')} class="hover:underline">Home</a> › <a href={withBase('/treinuitjes/vanuit/')} class="hover:underline">Vanuit jouw station</a> › <span aria-current="page">{station.data.name}</span></nav>
  <h1 class="mt-4 text-3xl font-bold">Treinuitjes vanuit {station.data.name}</h1>
  <p class="mt-2 flex flex-wrap items-center gap-2 text-sm text-slate-600">
    <FreshnessBadge at={reach.travel_date} kind="reistijd" estimated={estimated} />
    <span>gegevens van {reach.generated_at.slice(0, 10)}</span>
    <a href={PLANNER_URL} target="_blank" rel="noopener" class="underline">plan je werkelijke reis ↗</a>
  </p>
  {estimated && <p class="mt-2 rounded-lg bg-amber-50 p-3 text-sm text-amber-900">Reistijden zijn een schatting op basis van afstand. Zodra de dienstregelingsdata is gekoppeld (fase 4) worden ze vervangen door berekende reistijden met overstappen.</p>}
  <p class="mt-4"><a href={withBase(`/zoeken/?van=${station.id}`)} class="btn-primary">Filter op datum, budget en categorie</a></p>
  <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {rows.map(({ item, d }) => (
      <DestinationCard destination={d!} cityName={cityName.get(d!.data.city.id) ?? ''} stationName={stationName.get(d!.data.nearest_station.id) ?? ''} categoryNames={d!.data.categories.map((c) => categoryName.get(c.id) ?? c.id)} travelMinutes={item.travel_minutes} estimated={estimated} />
    ))}
  </div>
</Base>
